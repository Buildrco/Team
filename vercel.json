{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/our-works",
      "destination": "/works.html"
    },
    {
      "source": "/works",
      "destination": "/works.html"
    }
  ],
  "headers": [
    {
      "source": "/our-works",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/works",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ]
}
