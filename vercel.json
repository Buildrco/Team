{
  "version": 2,
  "routes": [
    {
      "src": "^/works$",
      "dest": "/index.html"
    },
    {
      "src": "^/our-works$",
      "dest": "/index.html"
    },
    {
      "src": "^/(works|our-works)(/.+)?/site-overrides\\.js$",
      "dest": "/site-overrides.js"
    },
    {
      "src": "^/(works|our-works)(/.+)?/works-gallery\\.js$",
      "dest": "/works-gallery.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
